# .env.example
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Required: MongoDB Connection String
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/glamsphere

# Required: JWT Secret (Generate a strong random string)
JWT_SECRET=your_super_secret_jwt_key
JWT_EXPIRES_IN=30d

# Optional: Razorpay (For actual payment processing)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# Optional: Cloudinary Cloud Name, API Key, API Secret
CLOUDINARY_CLOUD_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret
